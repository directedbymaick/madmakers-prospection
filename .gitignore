# ============================================================
# Mad Makers Prospection — .gitignore racine
# ============================================================

# ── Secrets (NE JAMAIS COMMITER) ───────────────────────────────
.env
.env.local
.env.*.local
*.env
config/.env
**/.env
!**/.env.example

# ── Donnees operationnelles (prospects, batchs, exports) ─────
# ⚠️ NE JAMAIS push sur le repo public (darthmaick). Origin = directedbymaick (privé).
**/data/*.json
**/data/*.csv
**/data/*.xlsx
**/data/*.xls
**/data/*.md
!**/data/README.md
# inputs/ : autorise uniquement les CSVs RocketReach pour le setup collab
**/data/inputs/*
!**/data/inputs/.gitkeep
!**/data/inputs/README.md
!**/data/inputs/rocketreach_bulk_*.csv
# Triage final uniquement (les intermédiaires restent ignorés)
!**/data/prospects_triage_strict_*_recheck.csv
!**/data/prospects_triage_final_*.csv
**/data/site_snapshots/
**/data/briefings/
**/data/run_*.txt
**/data/*.log
**/data/*.html
!**/data/.gitkeep

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.uv/
.python-version

# ── Outils dev ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Claude Code (perso, ne pas push) ─────────────────────────
.claude/settings.local.json

# ── CRM local DB (RGPD : prospects emails) ───────────────────
crm/data/*.db
crm/data/*.db-journal
crm/data/*.db-wal
crm/data/*.db-shm
