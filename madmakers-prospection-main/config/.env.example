# ============================================================
# MAD MAKERS PROSPECTION — template de secrets
# ============================================================
# Copier ce fichier vers `.env` à la racine du projet :
#   cp config/.env.example .env
# Puis remplir chaque clé. Le fichier `.env` est gitignoré.
# ============================================================


# --- INSEE SIRENE ---
# Inscription : https://api.insee.fr/catalogue/site/themes/wso2/subthemes/insee/pages/list-api.jag
# Tu crées une application, tu récupères un "Consumer Key" et un "Consumer Secret"
# Puis tu les combines pour un token (doc INSEE section "Authentification")
INSEE_API_KEY=
INSEE_API_SECRET=


# --- GOOGLE CLOUD (Places API + PageSpeed API) ---
# Console : https://console.cloud.google.com
# Activer : "Places API (New)" + "PageSpeed Insights API"
# Créer une clé API (Credentials → Create credentials → API key)
# Restreindre la clé aux deux APIs ci-dessus pour sécurité
GOOGLE_API_KEY=


# --- PAPPERS ---
# Inscription : https://www.pappers.fr/api
# Plan gratuit = 500 requêtes/mois (largement suffisant pour M1-M2)
PAPPERS_API_KEY=


# --- Paramètres Mad Makers ---
# Adresse d'envoi signature email (sera dans tous les emails générés)
MADMAKERS_FROM_NAME=Maïck — Mad Makers
MADMAKERS_FROM_EMAIL=contact@madmakers.fr
MADMAKERS_LANDING_URL=https://madmakers.fr/restaurants
MADMAKERS_PHONE=+33 6 XX XX XX XX


# --- Divers (optionnels, V2) ---
# DROPCONTACT_API_KEY=
# FOLK_API_KEY=
