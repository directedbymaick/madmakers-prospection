# ============================================================
# Mad Makers — Template .env (collab : copie en .env + remplis)
# ============================================================

# ── Resend (envoi emails verif + reset password) ────────────
# Demande la clé à Maïck (ne pas régénérer en dev, ça invaliderait)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@mad-makers.fr
RESEND_FROM_NAME=Mad Makers CRM

# ── Flask (sécurité sessions + tokens email) ────────────────
# Génère une clé locale via :
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-with-secrets-token-hex-32

# ── URL de base (pour les liens dans les emails) ────────────
# Local : http://127.0.0.1:8000
# Prod  : https://crm.mad-makers.fr
APP_BASE_URL=http://127.0.0.1:8000

# ── Whitelist emails autorisés à signup ─────────────────────
# Séparés par virgule. Tout email hors liste sera refusé au signup.
ALLOWED_EMAILS=mcksuperdukegaming@gmail.com,directedbymaick@gmail.com,contact@mad-makers.fr,rayanmpondo@mad-makers.fr,goudetabale@mad-makers.fr
